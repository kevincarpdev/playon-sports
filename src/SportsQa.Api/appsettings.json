{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Hosting": "Critical"
    }
  },
  "AllowedHosts": "*",
  "SportsQa": {
    "DatabasePath": "../../data/sports.db",
    "FakeLlmResponsesPath": "Llm/fake_llm_responses.json",
    "SemanticModelPath": "../../SEMANTIC_MODEL.md",
    "Execution": {
      "MaxRows": 100,
      "CommandTimeoutSeconds": 5,
      "MaxClarificationOptions": 4,
      "TopListSize": 5,
      "FuzzyAutoResolveMinGap": 0.1
    },
    "Trust": {
      "MinSlotConfidence": 0.75,
      "CertifiedQueryConfidence": 0.99,
      "ModelQueryConfidenceCap": 0.7,
      "TiePenalty": 0.15
    },
    "Authorization": {
      "DefaultRole": "Subscriber",
      "RoleHeader": "X-SportsQa-Role"
    }
  }
}
